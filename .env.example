# ---------------------------------------------------------------------------
# Blood Bank - environment file
#
# Copy this file to `.env` and write your own values:
#     cp .env.example .env
#
# Do not add the file `.env` to the repository. It holds secret values.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# The application reads these values in the file `model/db.php`.

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bloodbank
DB_USERNAME=root
DB_PASSWORD=

# --- Twilio (SMS) -----------------------------------------------------------
# The application reads these values in the file `functions/messages.php`.
# Get the SID and the token from the console at www.twilio.com/console.
# The from number must be a telephone number of your Twilio account.
#
# If you leave these values empty, the application does not send an SMS
# message. It writes a line to the error log instead.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
